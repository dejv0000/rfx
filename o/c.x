    <item>
      <title>[매일매일 중국어 한마디] 이어 붙이다</title>
      <link>https://www.chosun.com/national/nie/chinese/2026/09/15/XJPXBQIM5BH5TCJNTAPPN42VZE/</link>
      <guid isPermaLink="true">https://www.chosun.com/national/nie/chinese/2026/09/15/XJPXBQIM5BH5TCJNTAPPN42VZE/</guid>
      <dc:creator>조선일보</dc:creator>
      <description/>
      <pubDate>Mon, 14 Sep 2026 15:34:00 +0000</pubDate>
      <content:encoded>&lt;figure&gt;&lt;img align="center" src="https://cloudfront-ap-northeast-1.images.arcpublishing.com/chosun/MT3E7FFDVJGUZIVFIEB2FAMAKA.jpg"&gt;&lt;figcaption&gt;&lt;small&gt;&lt;/small&gt;&lt;/figcaption&gt;&lt;/figure&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;</content:encoded>

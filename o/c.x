    <item>
      <title>[오늘의 날씨] 2026년 10월 7일</title>
      <link>https://www.chosun.com/national/national_general/2026/10/07/M2PJ7TRNJVBHNBSJ4UKFIBICOQ/</link>
      <guid isPermaLink="true">https://www.chosun.com/national/national_general/2026/10/07/M2PJ7TRNJVBHNBSJ4UKFIBICOQ/</guid>
      <dc:creator>조선일보</dc:creator>
      <description/>
      <pubDate>Tue, 06 Oct 2026 15:50:00 +0000</pubDate>
      <content:encoded>&lt;figure&gt;&lt;img align="center" src="https://cloudfront-ap-northeast-1.images.arcpublishing.com/chosun/BRG3V7DS7NFKDJ2373N4ZVYQYM.jpg"&gt;&lt;figcaption&gt;&lt;small&gt;&lt;/small&gt;&lt;/figcaption&gt;&lt;/figure&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;</content:encoded>

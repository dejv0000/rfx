    <item>
      <title>[신문으로 배우는 실용한자] 합작(合作)</title>
      <link>https://www.chosun.com/national/nie/chinese_character/2026/10/27/GXYRRZF2KVHRZGQHJTTL4U4KV4/</link>
      <guid isPermaLink="true">https://www.chosun.com/national/nie/chinese_character/2026/10/27/GXYRRZF2KVHRZGQHJTTL4U4KV4/</guid>
      <dc:creator>조선일보</dc:creator>
      <description/>
      <pubDate>Mon, 26 Oct 2026 15:34:00 +0000</pubDate>
      <content:encoded>&lt;figure&gt;&lt;img align="center" src="https://cloudfront-ap-northeast-1.images.arcpublishing.com/chosun/DS7VBIFJ7FHIXPYWVTKYP7MR2A.jpg"&gt;&lt;figcaption&gt;&lt;small&gt;&lt;/small&gt;&lt;/figcaption&gt;&lt;/figure&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;</content:encoded>

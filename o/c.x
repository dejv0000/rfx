    <item>
      <title>[매일매일 중국어 한마디] 전공과목, 전공 수업</title>
      <link>https://www.chosun.com/national/nie/chinese/2026/09/02/FNDZF44DQNEGRGFXITJ3XBE7PM/</link>
      <guid isPermaLink="true">https://www.chosun.com/national/nie/chinese/2026/09/02/FNDZF44DQNEGRGFXITJ3XBE7PM/</guid>
      <dc:creator>조선일보</dc:creator>
      <description/>
      <pubDate>Tue, 01 Sep 2026 15:34:00 +0000</pubDate>
      <content:encoded>&lt;figure&gt;&lt;img align="center" src="https://cloudfront-ap-northeast-1.images.arcpublishing.com/chosun/NKZGYWPMY5DJVAZZIUCNXFVVS4.jpg"&gt;&lt;figcaption&gt;&lt;small&gt;&lt;/small&gt;&lt;/figcaption&gt;&lt;/figure&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;</content:encoded>
